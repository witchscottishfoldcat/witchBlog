{
  "name": "witchcatweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:avatar": "node scripts/copy-avatar-to-public.js",
    "copy:live2d": "node scripts/copy-live2d-model.js",
    "copy:cubism-core": "node scripts/copy-cubism-core.js",
    "postinstall": "node scripts/copy-cubism-core.js",
    "dev": "next dev",
    "dev:fast": "next dev --turbo -p 3001",
    "dev:no-turbo": "NEXT_PRIVATE_SKIP_TURBO=1 next dev -p 3001",
    "prebuild": "node scripts/copy-avatar-to-public.js && node scripts/copy-cubism-core.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "verify-assets": "node scripts/verify-assets.js"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@pixi/unsafe-eval": "^6.5.10",
    "contentlayer": "^0.3.4",
    "date-fns": "^3.6.0",
    "gray-matter": "^4.0.3",
    "live2dcubismcore": "^1.0.2",
    "next": "^15.5.24",
    "next-contentlayer": "^0.3.4",
    "next-intl": "^4.6.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "gh-pages": "^6.3.0",
    "protobufjs": "7.6.5",
    "nanoid": "^3.3.18",
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  }
}
