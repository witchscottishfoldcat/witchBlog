# 复制为 .env.local 后按实际环境填写（.env.local 已被 .gitignore 忽略，勿提交真实 IP）

# 对外站点地址，用于 canonical、Open Graph、robots.txt 与 sitemap.xml
NEXT_PUBLIC_SITE_URL=https://example.com

# 本地开发的后端地址
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 服务端图片服务器白名单（host 或 host:port，逗号分隔）
# 供 next.config.mjs 的 images.remotePatterns 与 /api/proxy-image 的服务端校验使用
# 注意：不要加 NEXT_PUBLIC_ 前缀，避免打进浏览器 bundle
IMAGE_SERVER_HOSTS=203.0.113.10:8000,198.51.100.25

# 客户端图片代理主机匹配列表（host，逗号分隔）
# 会内联进浏览器 bundle，仅填写需要走 /api/proxy-image 的主机
NEXT_PUBLIC_IMAGE_PROXY_HOSTS=203.0.113.10,198.51.100.25

# 缓存刷新密钥：后台（witchcat-cn）保存站点配置后调用 POST /api/site-config/revalidate
# 时携带，必须与后端的 FRONTEND_REVALIDATE_SECRET 完全一致。
# 未配置时开发环境免密放行、生产环境拒绝一切刷新调用。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
REVALIDATE_SECRET=
