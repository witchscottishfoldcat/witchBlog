# 项目配置
PROJECT_NAME=WitchCat Enterprise API
VERSION=1.0.2
API_V1_STR=/api/v1

# 服务器配置
DEBUG=False
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
# ⚠️ 必须设置：后端对外可访问的基础地址，用于拼接图片代理URL（隐藏OSS直链）
# 例如 http://your-domain.com 或 http://1.2.3.4:8000
# 不设置时图片URL会回退为相对路径，跨域前端将无法加载图片
BACKEND_BASE_URL=http://localhost:8000

# 安全配置
# ⚠️ 必须修改：生产环境密钥
SECRET_KEY=your-super-secret-key-change-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256
# 匿名 URL 抓取默认只允许 80/443，并自动拒绝本机、数据库、MinIO 和后端主机。
# 如服务还有额外公网 IP/域名，请加入逗号分隔的拒绝列表（部署时必须填写 NAT 公网 IP）。
SSRF_BLOCKED_HOSTS=api.example.com,203.0.113.10
# 仅在确有公网图片源使用非标准端口时显式扩展；不要加入数据库/MinIO 管理端口。
SSRF_ALLOWED_PORTS=80,443

# 数据库配置
# ⚠️ 必须修改：使用环境变量或安全密钥管理服务
#
# 环境文件约定：
#   .env         — 服务器 / Jenkins（库在本机：127.0.0.1:3306，ENVIRONMENT=production）
#   .env.local   — 本地开发（SSH 映射：127.0.0.1:13305，ENVIRONMENT=development）
# 本地存在 .env.local 时会自动优先加载；Jenkins 仍 docker --env-file ".env"
# 也可强制指定：ENV_FILE=.env python main.py
MYSQL_SERVER=127.0.0.1
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=witchcat
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/witchcat
# 本地开发示例（写在 .env.local）：
# ENVIRONMENT=development
# MYSQL_SERVER=127.0.0.1:13305
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:13305/witchcat

# Redis配置
REDIS_URL=redis://localhost:6379

# 时区配置
# TZ 影响容器内日志与本地时间；SCHEDULER_TIMEZONE 决定 cron 定时任务按何时区触发
TZ=Asia/Shanghai
SCHEDULER_TIMEZONE=Asia/Shanghai

# CORS配置
BACKEND_CORS_ORIGINS=["https://admin.example.com"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".txt",".pdf",".doc",".docx",".md",".jpg",".png"]

# MinIO配置
# ⚠️ 必须修改：使用环境变量或安全密钥管理服务
MINIO_ENDPOINT=your-minio-server:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_SECURE=False
MINIO_BUCKET_NAME=witchcat-files

# AI模型配置
# ⚠️ 必须修改：使用环境变量或安全密钥管理服务
AI_DEFAULT_PROVIDER=glm
GLM_API_KEY=your-glm-api-key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=GLM-4.6V-Flash
GLM_TIMEOUT=60

# DeepSeek配置（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# Kimi配置（可选）
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
KIMI_TIMEOUT=60

# Steam API配置（可选）
STEAM_API_KEY=your-steam-api-key
STEAM_DEFAULT_USER_ID=your-steam-user-id

# 网易云音乐API配置
NETEASE_API_BASE=http://localhost:3000
NETEASE_API_TIMEOUT=30

# 前台缓存刷新链路（后台保存站点配置后通知 Next.js 前台清缓存）
# FRONTEND_BASE_URL：前台（witchcat-web）的访问基地址，本地开发填 http://localhost:3000
# FRONTEND_REVALIDATE_SECRET：必须与前台的 REVALIDATE_SECRET 完全一致
# 两者任一留空时 POST /site-config/revalidate-frontend 返回 400（视为未接入）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_BASE_URL=
FRONTEND_REVALIDATE_SECRET=
