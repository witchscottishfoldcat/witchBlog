      "tests/test_site_config_revalidate.py",
      "tests/test_link_category_validation.py",
      "tests/test_links_random_route.py",
      "tests/test_error_envelope.py",
      "tests/test_project_stats_sync.py",
      "tests/test_auth.py",
      "tests/test_public_initialization.py",
      "tests/test_initialization_isolation.py",
      "--junitxml=docs/gates/latest/pytest.xml",
      "-p",
      "no:cacheprovider",
      "-W",
      "ignore::DeprecationWarning"
    ],
    "G3": [
      ".venv/Scripts/python.exe",
      "scripts/coverage_gate.py"
    ],
    "G2_FULL": [
      ".venv/Scripts/python.exe",
      "scripts/tests_gate.py"
